PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/artillery

# Logging
LOG_LEVEL=info
LOG_PRETTY=false

# Where completed Artillery JSON reports are persisted
ARTILLERY_REPORT_DIR=data/reports

# Max concurrently running Artillery children (each is a full process)
ARTILLERY_MAX_CONCURRENT=4

# Ingestion hardening (defense against abusive producers)
INGEST_MAX_MESSAGE_BYTES=1048576
INGEST_MAX_BATCH_POINTS=50000

# Optional Bearer token for the REST API and /ws. Empty disables auth.
API_TOKEN=

# Comma-separated browser origins allowed by CORS. Use * to allow any.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Kafka (optional — set to enable)
KAFKA_BROKERS=
KAFKA_TOPIC=artillery.metrics

# Ring buffer tuning
RING_CAPACITY=16384
FLUSH_BATCH_SIZE=5000
FLUSH_INTERVAL_MS=500
