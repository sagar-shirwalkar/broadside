PORT=3000
# Optional dedicated WebSocket ingest listener (/ws). Set to a different port
# (e.g. 3002) to isolate long-lived/high-volume ingest from REST/control/SSE.
# 0 keeps ingest on the main PORT only.
INGEST_PORT=0
DATABASE_URL=postgres://postgres:postgres@localhost:5432/artillery

# Logging
LOG_LEVEL=info
LOG_PRETTY=false

# HTTP server tuning (helps under load/self-load; tune with client keep-alive/pooling)
# KEEP_ALIVE_TIMEOUT_MS should exceed client/LB idle timeout.
SERVER_KEEP_ALIVE_TIMEOUT_MS=65000
# Must be greater than KEEP_ALIVE_TIMEOUT_MS.
SERVER_HEADERS_TIMEOUT_MS=66000
# 0 disables request timeout.
SERVER_REQUEST_TIMEOUT_MS=120000
# Rotate sockets to bound per-connection resource creep (0 = unlimited).
SERVER_MAX_REQUESTS_PER_SOCKET=1000

# Where completed Artillery JSON reports are persisted
ARTILLERY_REPORT_DIR=data/reports
# Best-effort Artillery child V8 heap limits in MB (0 = unset)
ARTILLERY_CHILD_MAX_OLD_MB=0
ARTILLERY_CHILD_MAX_YOUNG_MB=0
# Ingest stall detection for WS-streamed runs (ms)
INGEST_STALL_TIMEOUT_MS=30000
INGEST_STALL_CHECK_MS=5000

# Max concurrently running Artillery children (each is a full process)
# Behavior when hit: POST /api/runs returns 429 and does NOT create a run.
# Impact if raised: each extra concurrent run can take ~0.5–1.5GB RAM at
# peak (measured ~1.3GB for 1300 concurrent VUs) — size this against your
# actual free memory, not disk. Raising it to 6–8 is usually safe on a desktop.
ARTILLERY_MAX_CONCURRENT=4

# Ingestion hardening (defense against abusive producers)
# Behavior when hit: oversized messages are dropped with a client error;
# oversized batches have their excess points dropped and counted.
# Impact if raised: larger caps tolerate bigger producer bursts but allow
# a single malicious client to buffer more memory per message.
INGEST_MAX_MESSAGE_BYTES=1048576
INGEST_MAX_BATCH_POINTS=50000

# Optional Bearer token for the REST API and /ws. Empty disables auth.
# Behavior when set: every /api/runs/* request and the /ws upgrade must
# carry `Authorization: Bearer <token>` (or `?token=` for WS/SSE clients
# that cannot set headers). Health/liveness/readiness probes stay public.
API_TOKEN=

# Comma-separated browser origins allowed by CORS. Use * to allow any.
# Impact if widened too far: any website you visit could read API responses
# from your browser once it discovers the service (with your stored token).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Kafka (optional — set to enable)
KAFKA_BROKERS=
KAFKA_TOPIC=artillery.metrics

# Service role for split deployments: all | api | ingest
SERVICE_ROLE=all
# Public/base ingest URL for clients/orchestrators when ingest is split (e.g. ws://ingest:3002/ws)
INGEST_URL=

# Ring buffer / flusher tuning
# RING_CAPACITY: total in-memory ingestion buffer across shards. If a burst arrives faster
# than the flusher can drain it, the OLDEST points are dropped (counted in /readyz flusher stats)
# rather than blocking the process. Raising it trades memory for burst forgiveness.
RING_CAPACITY=16384
# FLUSH_BATCH_SIZE: maximum points per INSERT statement, and the buffer
# size that triggers an early flush (before the interval timer).
FLUSH_BATCH_SIZE=5000
# FLUSH_INTERVAL_MS: how often the flusher drains ring buffers to TimescaleDB.
FLUSH_INTERVAL_MS=500
# FLUSH_SHARDS: independent flusher shards (hash-mod by run_id) to isolate slow batches.
FLUSH_SHARDS=4
# INGEST_SLOWDOWN_THRESHOLD: ring-depth ratio (0-1) above which WS ingest sends slow_down control frames.
INGEST_SLOWDOWN_THRESHOLD=0.8

# Docker Compose resource tuning (used by docker-compose.yml variable substitution)
# DASHBOARD_CPUSET=0
# DASHBOARD_CPUS=1.0
# DASHBOARD_MEM_LIMIT=1g
# DASHBOARD_CPU_RESERVATION=0.25
# DASHBOARD_MEM_RESERVATION=256m
# INGEST_CPUSET=1
# INGEST_CPUS=1.0
# INGEST_MEM_LIMIT=1g
# INGEST_CPU_RESERVATION=0.25
# INGEST_MEM_RESERVATION=256m
# GRPC_PORT=3001

# Overview SLO thresholds (all optional with sensible defaults)
# SLO_P95_MS: headline p95 target used by the SLO strip ("p95 < 400ms: met in X%").
SLO_P95_MS=400
# SLO_ERROR_RATE: error-ratio target for the SLO strip (0.01 = 1%).
SLO_ERROR_RATE=0.01
# SLO_WINDOW_RUNS: how many recent runs back the SLO met-rate (status thresholds: >=90% pass, >=75% warn).
SLO_WINDOW_RUNS=30
# SLO_REGRESSION_DELTA: a run endpoint is flagged when its latest p95 exceeds the rolling median by this factor (1.2 = +20%).
SLO_REGRESSION_DELTA=1.2
