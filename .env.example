PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/artillery

# Logging
LOG_LEVEL=info
LOG_PRETTY=false

# Where completed Artillery JSON reports are persisted
ARTILLERY_REPORT_DIR=data/reports

# Max concurrently running Artillery children (each is a full process)
# Behavior when hit: POST /api/runs returns 429 and does NOT create a run.
# Impact if raised: each extra concurrent run can take ~0.5–1.5GB RAM at
# peak (measured ~1.3GB for 1300 concurrent VUs) — size this against your
# actual free memory, not disk. Raising it to 6–8 is usually safe on a desktop.
ARTILLERY_MAX_CONCURRENT=4

# Ingestion hardening (defense against abusive producers)
# Behavior when hit: oversized messages are dropped with a client error;
# oversized batches have their excess points dropped and counted.
# Impact if raised: larger caps tolerate bigger producer bursts but allow
# a single malicious client to buffer more memory per message.
INGEST_MAX_MESSAGE_BYTES=1048576
INGEST_MAX_BATCH_POINTS=50000

# Optional Bearer token for the REST API and /ws. Empty disables auth.
# Behavior when set: every /api/runs/* request and the /ws upgrade must
# carry `Authorization: Bearer <token>` (or `?token=` for WS/SSE clients
# that cannot set headers). /api/health stays public for probes.
API_TOKEN=

# Comma-separated browser origins allowed by CORS. Use * to allow any.
# Impact if widened too far: any website you visit could read API responses
# from your browser once it discovers the service (with your stored token).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Kafka (optional — set to enable)
KAFKA_BROKERS=
KAFKA_TOPIC=artillery.metrics

# Ring buffer tuning
# RING_CAPACITY: the in-memory ingestion buffer. If a burst arrives faster
# than the flusher can drain it, the OLDEST points are dropped (counted in
# /api/health) rather than blocking the process. Raising it trades memory
# for burst forgiveness; 16384 points ≈ a few MB of heap.
RING_CAPACITY=16384
# FLUSH_BATCH_SIZE: maximum points per INSERT statement, and the buffer
# size that triggers an early flush (before the interval timer).
# Raising it lowers insert count but lengthens write latency for all runs.
FLUSH_BATCH_SIZE=5000
# FLUSH_INTERVAL_MS: how often the flusher drains the ring buffer to TimescaleDB.
# Lower = fresher live charts (but more queries/sec and a CPU-heavy sweep),
# higher = leaner DB traffic with more live-chart lag. 500ms is a balanced default.
FLUSH_INTERVAL_MS=500
