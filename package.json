{
  "name": "broadside",
  "version": "0.2.0",
  "description": "Dashboard for Artillery-generated data",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "proto": "tsx scripts/generate.ts",
    "db:init": "psql $DATABASE_URL -f src/db/schema.sql",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "sagar-shirwalkar",
  "license": "MPL-2.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0",
  "dependencies": {
    "@bufbuild/protobuf": "^2.10.0",
    "@connectrpc/connect": "^2.3.0",
    "@connectrpc/connect-node": "^2.3.0",
    "@hono/node-server": "^2.1.5",
    "@hono/structured-logger": "^1.0.0",
    "@platformatic/kafka": "^2.11.0",
    "@zod/mini": "^4.6.7",
    "dotenv": "^18.0.9",
    "hono": "^4.13.0",
    "pino": "^10.4.0",
    "postgres": "^4.1.0",
    "ws": "^8.18.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.72.0",
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@go-task/cli": "^3.52.0",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^5.1.0",
    "fast-check": "^4.10.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
